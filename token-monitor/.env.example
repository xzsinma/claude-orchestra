# Optional: copy to .env only if you need to change something.

# Folder with your Claude Code transcripts (mounted read-only).
# Default: ~/.claude/projects (your user folder on any OS).
# CLAUDE_PROJECTS_DIR=

# Your time zone, so "today" and daily totals match your clock (e.g. Europe/Madrid).
TZ=UTC

# Host port (always bound to 127.0.0.1).
TOKEN_MONITOR_PORT=4317
